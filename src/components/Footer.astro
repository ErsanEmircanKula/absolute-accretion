---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="copyright">&copy; {today.getFullYear()} Fikir Dizini. Tüm hakları saklıdır.</p>
		<div class="footer-links">
			<a href="/about">Hakkımda</a>
			<a href="/blog">İletişim</a>
			<a href="/blog">Gizlilik Politikası</a>
		</div>
		<div class="social-links">
			<a href="https://beheysanathirsizi.substack.com/?utm_campaign=profile_chips" target="_blank" title="Substack" class="social-icon">
				<img src="/icon-substack.png" alt="Substack" class="social-img" />
			</a>
			<a href="https://www.linkedin.com/in/denizbakkaya/" target="_blank" title="LinkedIn" class="social-icon">
				<img src="/icon-linkedin.png" alt="LinkedIn" class="social-img" />
			</a>
			<a href="https://www.instagram.com/birdelininmalbeyani/" target="_blank" title="Instagram" class="social-icon">
				<img src="/icon-instagram.png" alt="Instagram" class="social-img" />
			</a>
			<a href="https://x.com/delininbeyani" target="_blank" title="Twitter / X" class="social-icon">
				<img src="/icon-twitter.png" alt="Twitter / X" class="social-img" />
			</a>
		</div>
	</div>
</footer>
<style>
	footer {
		margin: 0;
		padding: 0.55rem 0.9rem;
		background: #151515;
		color: #f2e7d8;
	}
	.footer-inner {
		width: min(1260px, calc(100% - 0.8rem));
		margin: 0 auto;
		padding: 0.15rem 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.copyright {
		margin: 0;
		font-size: 0.8rem;
		color: rgba(242, 231, 216, 0.82);
	}
	.footer-links {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		font-size: 0.82rem;
	}
	.footer-links a {
		color: rgba(242, 231, 216, 0.82);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 0.7rem;
	}
	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		transition: opacity 160ms ease;
	}
	.social-icon:hover {
		opacity: 0.75;
	}
	.social-img {
		height: 20px;
		width: auto;
		object-fit: contain;
		filter: brightness(1.1) saturate(0.9);
	}
	@media (max-width: 720px) {
		.footer-inner {
			width: min(100%, calc(100% - 0.6rem));
			padding: 0.5rem 0;
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
		.footer-links {
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>
