---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<header>
	<nav>
		<div class="logo-title">
			<img src="/logo-avatar.png" alt="Fikir Dizini avatar" class="logo" />
			<div class="brand-copy">
				<h2><a href="/">{SITE_TITLE}</a></h2>
				<p>Haberler. Hikayeler. Fikirler.</p>
			</div>
		</div>
		<div class="internal-links">
			<HeaderLink href="/about">Hakkımda</HeaderLink>
			<HeaderLink href="/">Ana Sayfa</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0.72rem 1rem;
		background: #f3eee6;
		border-bottom: 1px solid rgba(79, 64, 50, 0.3);
	}
	.logo-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}
	.logo {
		height: 48px;
		width: auto;
		object-fit: contain;
		border-radius: 0;
	}
	h2 {
		margin: 0;
		font-size: 2rem;
		line-height: 1;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.brand-copy {
		display: grid;
		gap: 0.18rem;
	}
	.brand-copy p {
		margin: 0;
		font-size: 0.9rem;
		letter-spacing: 0.01em;
		text-transform: none;
		color: rgb(var(--gray));
	}
	nav {
		width: min(1260px, calc(100% - 1rem));
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-left: auto;
	}
	nav a {
		padding: 0.5rem 0.2rem;
		color: rgb(var(--black));
		border-bottom: 0;
		text-decoration: none;
		transition: color 160ms ease;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	nav a:hover {
		color: var(--accent-dark);
	}
	nav a.active {
		text-decoration: none;
		color: rgb(var(--black));
		position: relative;
	}
	nav a.active::after {
		content: '';
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		bottom: -0.12rem;
		width: 0.36rem;
		height: 0.36rem;
		border-radius: 999px;
		background: rgb(var(--black));
	}
	@media (max-width: 720px) {
		header {
			padding: 0.6rem 0.7rem;
		}
		nav {
			flex-wrap: wrap;
			width: 100%;
		}
		.brand-copy p {
			display: none;
		}
		.internal-links {
			order: 3;
			width: 100%;
			overflow-x: auto;
			margin-left: 0;
			padding-bottom: 0.15rem;
		}
		nav a {
			padding: 0.5rem 0.25rem;
			font-size: 0.92rem;
		}
	}
</style>
