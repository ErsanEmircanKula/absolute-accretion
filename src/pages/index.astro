---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recentPosts = posts.slice(0, 4);
const categoryCounts = Array.from(
	posts.reduce((counts, post) => {
		const category = post.data.category ?? 'Genel';
		counts.set(category, (counts.get(category) ?? 0) + 1);
		return counts;
	}, new Map<string, number>()),
).sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1200px, calc(100% - 1rem));
				margin-top: 0.9rem;
				padding: 0;
				background: transparent;
				border: 0;
				box-shadow: none;
			}
			.hero {
				display: grid;
				grid-template-columns: minmax(430px, 1.08fr) minmax(300px, 0.92fr);
				gap: 1rem;
				align-items: stretch;
				margin-bottom: 1rem;
			}
			.hero-art,
			.hero-copy,
			.section-panel,
			.sidebar-card {
				border: 1px solid rgba(153, 126, 98, 0.22);
				border-radius: 20px;
				background: rgba(252, 246, 236, 0.92);
				box-shadow: 0 10px 24px rgba(52, 37, 28, 0.08);
			}
			.hero-copy {
				padding: clamp(1.2rem, 2.4vw, 2rem);
				display: grid;
				align-content: start;
				gap: 0.85rem;
			}
			.hero-copy p {
				max-width: 58ch;
			}
			.hero-art {
				overflow: hidden;
				position: relative;
				display: grid;
				place-items: center;
				min-height: 560px;
				background:
					linear-gradient(180deg, rgba(94, 63, 44, 0.14), rgba(94, 63, 44, 0) 20%),
					linear-gradient(180deg, #7a563d 0%, #9f7a54 18%, #ead2b0 18%, #f5e5c9 100%);
			}
			.hero-art::before {
				content: '';
				position: absolute;
				inset: 16px;
				border-radius: 18px;
				border: 1px solid rgba(255, 246, 230, 0.18);
				pointer-events: none;
			}
			.hero-art img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.hero-caption {
				position: absolute;
				left: 1rem;
				bottom: 1rem;
				padding: 0.52rem 0.72rem;
				border-radius: 999px;
				background: rgba(35, 24, 18, 0.62);
				color: #f6ebda;
				font-size: 0.75rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 0.25rem;
			}
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.85rem 1.2rem;
				border-radius: 999px;
				text-decoration: none;
				font-size: 0.95rem;
				font-weight: 700;
				border: 1px solid rgba(45, 32, 24, 0.14);
			}
			.button-primary {
				background: linear-gradient(180deg, #8a6a45, #72543a);
				color: #fbf6ee;
			}
			.button-primary:hover {
				background: linear-gradient(180deg, #755837, #5f452f);
				color: #fbf6ee;
			}
			.button-secondary {
				border-color: rgba(122, 99, 74, 0.22);
				color: rgb(var(--gray-dark));
				background: rgba(255, 251, 244, 0.9);
			}
			.button-secondary:hover {
				border-color: rgba(139, 107, 69, 0.32);
				color: var(--accent-dark);
			}
			.hero-copy h2,
			.story-card h3 {
				margin: 0;
			}
			.hero-copy .title-link,
			.story-card .title-link {
				text-decoration: none;
				color: inherit;
			}
			.hero-copy .title-link:hover,
			.story-card .title-link:hover {
				color: var(--accent-dark);
			}
			.manifesto {
				margin-top: 0.2rem;
				padding: 1rem 1.05rem;
				border-left: 4px solid rgba(139, 107, 69, 0.88);
				background: rgba(112, 100, 87, 0.05);
				border-radius: 16px;
			}
			.manifesto ul {
				margin: 0.8rem 0 0;
				padding-left: 1.2rem;
			}
			.section-row {
				display: flex;
				justify-content: space-between;
				align-items: end;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.section-panel {
				padding: 1.25rem;
			}
			.content-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 336px;
				gap: 1.1rem;
				align-items: start;
			}
			.story-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 0.95rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.story-card {
				height: 100%;
				display: grid;
				grid-template-columns: 240px minmax(0, 1fr);
				grid-template-rows: auto;
				align-items: stretch;
				min-height: 230px;
			}
			.story-card figure {
				margin: 0;
				height: 100%;
			}
			.story-card img {
				display: block;
				width: 100%;
				height: 100%;
				min-height: 180px;
				object-fit: cover;
				border-radius: 0;
			}
			.story-copy {
				display: grid;
				gap: 0.6rem;
				padding: 1.05rem 1rem 1rem 1.05rem;
				align-content: start;
			}
			.story-card .card-meta {
				text-transform: none;
				letter-spacing: 0;
				font-size: 0.9rem;
			}
			.story-card .card-excerpt {
				font-size: 0.95rem;
			}
			.sidebar {
				display: grid;
				gap: 1rem;
			}
			.sidebar-card {
				padding: 1.1rem;
			}
			.sidebar-card h3 {
				margin-bottom: 0.8rem;
				font-size: 1.25rem;
			}
			.category-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.55rem;
			}
			.category-list a {
				display: flex;
				justify-content: space-between;
				gap: 0.75rem;
				text-decoration: none;
				color: rgb(var(--gray-dark));
				padding-bottom: 0.45rem;
				border-bottom: 1px solid rgba(102, 78, 54, 0.12);
			}
			.newsletter {
				display: grid;
				gap: 0.75rem;
			}
			.newsletter input {
				width: 100%;
				padding: 0.8rem 0.85rem;
				border-radius: 12px;
				border: 1px solid rgba(102, 78, 54, 0.18);
				background: rgba(255, 251, 244, 0.96);
				font: inherit;
				box-sizing: border-box;
			}
			.newsletter button {
				width: 100%;
				padding: 0.82rem 1rem;
				border: 0;
				border-radius: 12px;
				background: linear-gradient(180deg, #23201c, #12110f);
				color: #f6ebda;
				font-weight: 700;
				box-sizing: border-box;
			}
			@media (max-width: 980px) {
				.hero {
					grid-template-columns: 1fr;
				}
				.content-grid {
					grid-template-columns: 1fr;
				}
				.hero-art {
					min-height: 420px;
				}
			}
			@media (max-width: 720px) {
				main {
					width: min(100%, calc(100% - 0.5rem));
					margin-top: 0.5rem;
				}
				.hero-copy,
				.hero-art,
				.section-panel {
					border-radius: 18px;
				}
				.hero-actions {
					flex-direction: column;
				}
				.button {
					width: 100%;
				}
				.section-row {
					flex-direction: column;
					align-items: start;
				}
				.story-grid {
					grid-template-columns: 1fr;
				}
				.story-card {
					grid-template-columns: 1fr;
				}
				.hero-art {
					min-height: 340px;
				}
				.story-card img {
					min-height: 220px;
				}
				.hero-caption {
					left: 0.7rem;
					bottom: 0.7rem;
				}
				.sidebar {
					grid-template-columns: 1fr;
				}
			}
			.corner-character {
				position: fixed;
				right: 0.7rem;
				bottom: 0.7rem;
				display: inline-flex;
				z-index: 35;
				pointer-events: none;
			}
			.corner-character img {
				display: block;
				width: 280px;
				height: auto;
				border-radius: 0;
			}
			@media (max-width: 980px) {
				.corner-character img {
					width: 220px;
				}
			}
			@media (max-width: 720px) {
				.corner-character {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<aside class="hero-art">
					<img src="/dipnot-character.jpeg" alt="Deniz B. Akkaya'nın okuma sahnesi" loading="eager" />
					<span class="hero-caption">Fikir Dizini / Dipnot</span>
				</aside>
				<div class="hero-copy">
					<p class="eyebrow">Bağımsız okuma notları</p>
					<h1>Dipnot</h1>
					<p class="lede">
						Fikir Dizini, günceli hızlı tüketmek yerine bağlamıyla okumak isteyenler için kurulmuş bir editoryal blogdur. Burada amaç gürültüyü azaltıp anlamı öne çıkarmak.
					</p>
					<div class="manifesto">
						<strong class="eyebrow">Kısa manifesto</strong>
						<ul>
							<li>Doğrulanmamış bilgiyi büyütmeyiz.</li>
							<li>Her metinde bağlamı, etik çerçeveyi ve okur aklını koruruz.</li>
							<li>Hızlı tüketim yerine kalıcı bir okuma deneyimi kurarız.</li>
						</ul>
					</div>
					<div class="hero-actions">
						<a class="button button-primary" href="/blog">Yazılara git</a>
						<a class="button button-secondary" href="/about">Yazar hakkında</a>
					</div>
				</div>
			</section>

			<section class="content-grid">
				<div class="section-panel">
					<div class="section-row">
						<div>
							<p class="eyebrow">Son yazılar</p>
							<h2 class="section-heading">Güncel yazılar</h2>
							<p class="lede">Bağımsız, sakin ve bağlam kuran bir okuma akışı.</p>
						</div>
						<a href="/blog">Tüm yazılar →</a>
					</div>
					<ul class="story-grid" id="recent">
						{
							recentPosts.map((post) => (
								<li>
									<a class="card-link" href={`/blog/${post.id}/`}>
										<article class="card-surface story-card">
											{post.data.heroImage && (
												<figure>
													{typeof post.data.heroImage === 'string' ? (
														<img src={post.data.heroImage} alt="" loading="lazy" />
													) : (
														<Image width={720} height={450} src={post.data.heroImage} alt="" />
													)}
												</figure>
											)}
											<div class="story-copy">
												<div class="card-pill-row">
													{post.data.series && <span class="meta-pill">{post.data.series}</span>}
													{post.data.category && <span class="meta-pill">{post.data.category}</span>}
												</div>
												<p class="card-meta">
													<FormattedDate date={post.data.pubDate} />
												</p>
												<h3>{post.data.title}</h3>
												<p class="card-excerpt">{post.data.description}</p>
											</div>
										</article>
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<aside class="sidebar">
					<section class="sidebar-card" id="categories">
						<p class="eyebrow">Kategoriler</p>
						<h3>Konular</h3>
						<ul class="category-list">
							<li>
								<a href="/blog"><span>Tümü</span><strong>{posts.length}</strong></a>
							</li>
							{
								categoryCounts.map(([category, count]) => (
									<li>
										<a href="/blog"><span>{category}</span><strong>{count}</strong></a>
									</li>
								))
							}
						</ul>
					</section>
					<section class="sidebar-card newsletter">
						<p class="eyebrow">Bültene katıl</p>
						<h3>Yeni yazılar e-postana gelsin</h3>
						<p class="card-excerpt">Haftalık notları ve yeni dosyaları kısa bir e-posta olarak göndermek için bekleme listesi formu.</p>
						<label class="sr-only" for="newsletter-email">E-posta adresiniz</label>
						<input id="newsletter-email" type="email" placeholder="E-posta adresiniz" />
						<button type="button">Katıl</button>
					</section>
				</aside>
			</section>
		</main>
		<a class="corner-character" href="/about" aria-label="Hakkında sayfasına git">
			<img src="/dipnot-character1.png" alt="Sağ alt köşe karakteri" loading="lazy" />
		</a>
		<Footer />
	</body>
</html>
