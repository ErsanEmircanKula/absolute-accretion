---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1200px, calc(100% - 1rem));
				padding-top: 0.25rem;
				padding-bottom: 0.5rem;
			}
			.blog-intro {
				max-width: none;
				width: 100%;
				margin-bottom: 1rem;
				padding: 0.15rem 0.2rem 0;
			}
			.blog-intro .lede {
				max-width: none;
				width: 100%;
			}
			.blog-intro h1 {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				font-size: clamp(2rem, 4.2vw, 3.9rem);
				line-height: 1.02;
			}
			.post-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.05rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-grid li {
				max-width: none;
				width: 100%;
			}
			.featured-item {
				grid-column: auto;
			}
			.post-link {
				text-decoration: none;
				color: inherit;
				display: block;
				height: 100%;
			}
			.post-card {
				display: grid;
				grid-template-columns: 260px minmax(0, 1fr);
				grid-template-rows: auto;
				align-items: start;
				min-height: 250px;
				width: 100%;
			}
			.post-card figure {
				margin: 0;
				height: 100%;
			}
			.post-card img {
				display: block;
				width: 100%;
				height: 100%;
				min-height: 210px;
				object-fit: cover;
				border-radius: 0;
			}
			.post-body {
				display: grid;
				gap: 0.8rem;
				padding: 1.1rem 1.1rem 1.05rem 1.1rem;
				align-content: start;
			}
			.card-pill-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}
			.post-card h2 {
				margin: 0;
			}
			.post-link:hover .card-surface,
			.post-link:focus-visible .card-surface {
				transform: translateY(-4px);
				box-shadow: var(--box-shadow);
				border-color: rgba(139, 107, 69, 0.22);
				}
			.post-card .card-meta {
				text-transform: none;
				letter-spacing: 0;
				font-size: 0.9rem;
				}
			.post-card .card-excerpt {
				font-size: 0.97rem;
			}
			@media (max-width: 980px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
				.post-card {
					grid-template-columns: 1fr;
				}
				main {
					width: min(100%, calc(100% - 0.7rem));
				}
			}
			@media (max-width: 720px) {
				main {
					width: min(100%, calc(100% - 0.5rem));
					padding-top: 0.2rem;
					padding-bottom: 0.6rem;
				}
				.blog-intro {
					margin-bottom: 0.9rem;
				}
				.blog-intro h1 {
					font-size: clamp(1.25rem, 6.6vw, 2rem);
				}
				.post-body {
					padding: 1rem;
				}
				.post-card img {
					min-height: 240px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-intro">
				<p class="eyebrow">Arşiv</p>
				<h1>Yazılar, dosyalar ve notlar.</h1>
				<p class="lede">
					Fikir Dizini'ndeki tüm yazılar tek bir editoryal ritimle sunulur. Kısa, okunabilir ve bağlamı kaybetmeyen bir liste hedefledim.
				</p>
			</section>

			<section>
				<ul class="post-grid">
					{
						posts.map((post, index) => (
							<li class={index === 0 ? 'featured-item' : ''}>
								<a class="post-link" href={`/blog/${post.id}/`}>
									<article class="card-surface post-card">
										{post.data.heroImage && (
											<figure>
												{typeof post.data.heroImage === 'string' ? (
													<img src={post.data.heroImage} alt="" loading="lazy" />
												) : (
													<Image width={index === 0 ? 960 : 720} height={index === 0 ? 540 : 450} src={post.data.heroImage} alt="" />
												)}
											</figure>
										)}
										<div class="post-body">
											<div class="card-pill-row">
												{post.data.series && <span class="meta-pill">{post.data.series}</span>}
												{post.data.category && <span class="meta-pill">{post.data.category}</span>}
											</div>
											<p class="card-meta">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<h2>{post.data.title}</h2>
											<p class="card-excerpt">{post.data.description}</p>
										</div>
									</article>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
